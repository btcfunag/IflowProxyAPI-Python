"""主程序入口 - FastAPI 服务器"""
import asyncio
import uvicorn
from contextlib import asynccontextmanager
from datetime import datetime, timezone
from typing import AsyncGenerator
from fastapi import FastAPI, Request
from fastapi.responses import JSONResponse, StreamingResponse
from app import (
    logger,
    console,
    auth_service,
    store_service,
    proxy_service,
    iflow_auth_service,
    iflow_executor_service,
    __version__,
)
from app.api import router as api_router
from app.settings import API_HOST, API_PORT, DEBUG


async def create_sse_stream(
    executor,
    auth_storage,
    chat_request,
) -> AsyncGenerator[str, None]:
    """
    生成SSE流式响应（带心跳机制，与Go项目保持一致）
    
    特性：
    1. 延迟设置header：等到第一个有效数据块到达后再设置header
    2. Keep-Alive心跳：定时发送心跳保持连接活跃
    """
    chunk_count = 0
    first_chunk_time = None
    total_bytes = 0
    last_heartbeat = datetime.now()
    headers_set = False
    
    logger.info(f"开始生成流式响应...")
    
    async for chunk in executor.execute_chat_completion_stream(auth_storage, chat_request):
        chunk_count += 1
        chunk_len = len(chunk)
        total_bytes += chunk_len
        current_time = datetime.now()
        
        # 首次收到数据时设置SSE headers（延迟设置策略，与Go项目一致）
        if chunk_count == 1:
            first_chunk_time = current_time.isoformat()
            logger.info(f"首个chunk时间: {first_chunk_time}")
            headers_set = True
        
        # 发送心跳（每15秒，与Go项目保持一致）
        elapsed = (current_time - last_heartbeat).total_seconds()
        if elapsed >= 15.0:
            last_heartbeat = current_time
            # 发送SSE心跳: : keep-alive\n\n
            yield ": keep-alive\n\n"
            logger.debug(f"发送SSE心跳")
        
        # 记录前3个chunk的详细内容（显示实际发送的格式）
        if chunk_count <= 3:
            # 显示原始字符串，包括所有换行符
            safe_chunk = chunk.replace('\r', '\\r').replace('\n', '\\n')
            preview_len = min(120, len(safe_chunk))
            logger.info(f"Chunk {chunk_count} ({chunk_len}B, total:{total_bytes}B): {safe_chunk[:preview_len]}...")
        
        # 直接yield，不添加额外字符
        yield chunk
    
    logger.info(f"流式响应完成，共 {chunk_count} 个 chunks, 总计 {total_bytes} 字节")


def create_test_sse_stream() -> AsyncGenerator[str, None]:
    """生成测试SSE流式响应（带心跳机制）"""
    import json
    test_data = [
        {"id": "test-1", "object": "chat.completion.chunk", "created": 1234567890, "model": "test", "choices": [{"index": 0, "delta": {"content": "Hello"}, "finish_reason": None}]},
        {"id": "test-2", "object": "chat.completion.chunk", "created": 1234567891, "model": "test", "choices": [{"index": 0, "delta": {"content": " world"}, "finish_reason": None}]},
        {"id": "test-3", "object": "chat.completion.chunk", "created": 1234567892, "model": "test", "choices": [{"index": 0, "delta": {"content": "!"}, "finish_reason": "stop"}]},
    ]
    
    from datetime import datetime
    last_heartbeat = datetime.now()
    
    for i, data in enumerate(test_data):
        current_time = datetime.now()
        
        # 发送心跳（模拟长连接）
        elapsed = (current_time - last_heartbeat).total_seconds()
        if elapsed >= 15.0:
            last_heartbeat = current_time
            yield ": keep-alive\n\n"
            logger.debug("测试SSE: 发送心跳")
        
        yield f"data: {json.dumps(data)}\n\n"
    
    yield "data: [DONE]\n\n"
    logger.info("测试SSE: 发送完成")


@asynccontextmanager
async def lifespan(app):
    """应用生命周期管理"""
    # 启动时初始化
    console.print(f"\n[bold cyan]CLIProxyAPI[/bold cyan] v{__version__} 启动中...")
    
    # 初始化数据库
    logger.info("正在初始化数据库...")
    await auth_service.init_db()
    await store_service.init_db()
    await proxy_service.init_db()
    
    logger.info("所有服务初始化完成")
    console.print(f"[green]✓[/green] 服务启动成功")
    console.print(f"[cyan]API 地址:[/cyan] http://{API_HOST}:{API_PORT}")
    console.print(f"[cyan]API 文档:[/cyan] http://{API_HOST}:{API_PORT}/docs")
    console.print()
    
    yield
    
    # 关闭时清理
    logger.info("正在关闭服务...")
    await store_service.close()
    await iflow_executor_service.close()
    logger.info("服务已关闭")


# 创建 FastAPI 应用
def create_app():
    from fastapi import FastAPI, Request
    from fastapi.middleware.cors import CORSMiddleware
    
    app = FastAPI(
        title="CLIProxyAPI",
        description="命令行代理 API 管理工具",
        version=__version__,
        lifespan=lifespan,
    )
    
    # 添加 CORS 中间件
    app.add_middleware(
        CORSMiddleware,
        allow_origins=["*"],
        allow_credentials=True,
        allow_methods=["*"],
        allow_headers=["*"],
    )
    
    # 注意：gzip 压缩在 uvicorn 级别控制，不需要在 FastAPI 中间件中处理
    # 通过在 main() 函数中配置 uvicorn 的 compression_types 来禁用 gzip
    
    # 注册 API 路由（带 /api 前缀）
    app.include_router(api_router, prefix="/api", tags=["API"])
    
    # 注册 OpenAI 兼容接口（根路径，无 /api 前缀）
    from fastapi.responses import StreamingResponse
    from app.iflow.service import iflow_executor_service as executor, iflow_auth_service as auth_svc
    from app.iflow.models import IFlowChatCompletionRequest, IFlowChatMessage
    from app.logger import logger
    
    @app.get("/v1/models")
    async def v1_models(request: Request):
        """OpenAI 兼容的模型列表接口"""
        # 获取客户端信息
        client_host = request.client.host if request.client else "unknown"
        client_port = request.client.port if request.client else "unknown"
        user_agent = request.headers.get("User-Agent", "unknown")
        accept = request.headers.get("Accept", "unknown")
        authorization = request.headers.get("Authorization", "missing")
        
        # 脱敏显示
        if user_agent != "unknown" and len(user_agent) > 50:
            user_agent = user_agent[:50]
        if authorization != "missing":
            auth_display = f"Bearer {authorization[0:10]}..." if len(authorization) > 15 else "Bearer [short]"
        else:
            auth_display = "missing"
        
        logger.info(f"===== MODELS REQUEST =====")
        logger.info(f"客户端: {client_host}:{client_port}")
        logger.info(f"User-Agent: {user_agent}")
        logger.info(f"Accept: {accept}")
        logger.info(f"Authorization: {auth_display}")
        logger.info(f"完整请求头: {dict(request.headers)}")
        logger.info(f"==========================")
        
        # 获取所有已配置的账号
        auths = auth_svc.load_all_auths()
        logger.info(f"加载到 {len(auths)} 个 iFlow 账号")
        
        # iFlow 支持的完整模型列表（参考 Go 实现）
        iflow_models = [
            {"id": "tstars2.0", "created": 1746489600, "display_name": "TStars-2.0", "description": "iFlow TStars-2.0 multimodal assistant"},
            {"id": "qwen3-coder-plus", "created": 1753228800, "display_name": "Qwen3-Coder-Plus", "description": "Qwen3 Coder Plus code generation"},
            {"id": "qwen3-max", "created": 1758672000, "display_name": "Qwen3-Max", "description": "Qwen3 flagship model"},
            {"id": "qwen3-vl-plus", "created": 1758672000, "display_name": "Qwen3-VL-Plus", "description": "Qwen3 multimodal vision-language"},
            {"id": "qwen3-max-preview", "created": 1757030400, "display_name": "Qwen3-Max-Preview", "description": "Qwen3 Max preview build"},
            {"id": "kimi-k2-0905", "created": 1757030400, "display_name": "Kimi-K2-Instruct-0905", "description": "Moonshot Kimi K2 instruct 0905"},
            {"id": "glm-4.6", "created": 1759190400, "display_name": "GLM-4.6", "description": "Zhipu GLM 4.6 general model"},
            {"id": "glm-4.7", "created": 1766448000, "display_name": "GLM-4.7", "description": "Zhipu GLM 4.7 general model"},
            {"id": "kimi-k2", "created": 1752192000, "display_name": "Kimi-K2", "description": "Moonshot Kimi K2 general model"},
            {"id": "kimi-k2-thinking", "created": 1762387200, "display_name": "Kimi-K2-Thinking", "description": "Moonshot Kimi K2 thinking model"},
            {"id": "deepseek-v3.2-chat", "created": 1764576000, "display_name": "DeepSeek-V3.2", "description": "DeepSeek V3.2 Chat"},
            {"id": "deepseek-v3.2-reasoner", "created": 1764576000, "display_name": "DeepSeek-V3.2", "description": "DeepSeek V3.2 Reasoner"},
            {"id": "deepseek-v3.2", "created": 1759104000, "display_name": "DeepSeek-V3.2-Exp", "description": "DeepSeek V3.2 experimental"},
            {"id": "deepseek-v3.1", "created": 1756339200, "display_name": "DeepSeek-V3.1-Terminus", "description": "DeepSeek V3.1 Terminus"},
            {"id": "deepseek-r1", "created": 1737331200, "display_name": "DeepSeek-R1", "description": "DeepSeek reasoning model R1"},
            {"id": "deepseek-v3", "created": 1734307200, "display_name": "DeepSeek-V3-671B", "description": "DeepSeek V3 671B"},
            {"id": "qwen3-32b", "created": 1747094400, "display_name": "Qwen3-32B", "description": "Qwen3 32B"},
            {"id": "qwen3-235b-a22b-thinking-2507", "created": 1753401600, "display_name": "Qwen3-235B-A22B-Thinking", "description": "Qwen3 235B A22B Thinking (2507)"},
            {"id": "qwen3-235b-a22b-instruct", "created": 1753401600, "display_name": "Qwen3-235B-A22B-Instruct", "description": "Qwen3 235B A22B Instruct"},
            {"id": "qwen3-235b", "created": 1753401600, "display_name": "Qwen3-235B-A22B", "description": "Qwen3 235B A22B"},
            {"id": "minimax-m2", "created": 1758672000, "display_name": "MiniMax-M2", "description": "MiniMax M2"},
            {"id": "minimax-m2.1", "created": 1766448000, "display_name": "MiniMax-M2.1", "description": "MiniMax M2.1"},
        ]
        
        logger.info(f"基础模型列表共 {len(iflow_models)} 个模型")
        
        # 为每个账号生成带前缀的模型
        models = []
        for auth in auths:
            for base_model in iflow_models:
                model_entry = {
                    "id": f"{auth.email}-{base_model['id']}",
                    "object": "model",
                    "created": base_model["created"],
                    "owned_by": auth.email,
                }
                models.append(model_entry)
        
        logger.info(f"为 {len(auths)} 个账号生成 {len(models)} 个模型")
        
        return {
            "object": "list",
            "data": models,
        }
    
    @app.post("/v1/chat/completions")
    async def v1_chat_completions(request: Request):
        """OpenAI 兼容的 Chat Completion 接口"""
        from pydantic import BaseModel
        from typing import List, Optional
        from fastapi import HTTPException
        from datetime import datetime
        
        # 记录完整请求头信息用于调试
        client_host = request.client.host if request.client else "unknown"
        client_port = request.client.port if request.client else "unknown"
        user_agent = request.headers.get("User-Agent", "unknown")
        accept = request.headers.get("Accept", "unknown")
        content_type = request.headers.get("Content-Type", "unknown")
        authorization = request.headers.get("Authorization", "missing")
        
        # 脱敏显示
        if user_agent != "unknown" and len(user_agent) > 50:
            user_agent = user_agent[:50]
        if authorization != "missing":
            auth_display = f"Bearer {authorization[0:10]}..." if len(authorization) > 15 else "Bearer [short]"
        else:
            auth_display = "missing"
        
        logger.info(f"===== CHAT REQUEST =====")
        logger.info(f"客户端: {client_host}:{client_port}")
        logger.info(f"User-Agent: {user_agent}")
        logger.info(f"Accept: {accept}")
        logger.info(f"Content-Type: {content_type}")
        logger.info(f"Authorization: {auth_display}")
        logger.info(f"完整请求头: {dict(request.headers)}")
        logger.info(f"请求时间: {datetime.now().isoformat()}")
        logger.info(f"=======================")
        
        # 解析请求体
        try:
            body = await request.json()
        except Exception as e:
            logger.error(f"解析请求体失败: {e}")
            raise HTTPException(status_code=400, detail="无效的 JSON 请求体")
        
        # 记录完整请求体（脱敏）
        model = body.get("model", "")
        messages = body.get("messages", [])
        stream = body.get("stream", True)  # 默认启用流式响应，与Go项目保持一致
        max_tokens = body.get("max_tokens")
        temperature = body.get("temperature")
        top_p = body.get("top_p")
        presence_penalty = body.get("presence_penalty")
        frequency_penalty = body.get("frequency_penalty")
        reasoning_effort = body.get("reasoning_effort")
        
        # 如果请求中明确设置了 stream=False，仍然尊重客户端的选择
        # 但如果未设置或设置为非布尔值，默认使用流式响应
        if not isinstance(stream, bool):
            stream = True
        
        logger.info(f"请求参数 - model: {model}, messages: {len(messages)}, stream: {stream} (默认启用)")
        logger.debug(f"完整请求体: {body}")
        
        # 记录认证邮箱信息
        model_parts = model.split("-", 1)
        if len(model_parts) >= 2:
            email = model_parts[0]
            logger.info(f"从模型名提取邮箱: {email[:5]}...{email[-5:]}")
        else:
            logger.info(f"模型名无邮箱前缀，将使用默认账号")
        
        # 验证必要参数
        if not model:
            raise HTTPException(status_code=400, detail="模型名称不能为空")
        
        if not messages:
            raise HTTPException(status_code=400, detail="消息不能为空")
        
        # 加载认证信息
        model_parts = model.split("-", 1)
        if len(model_parts) < 2:
            auths = auth_svc.load_all_auths()
            logger.debug(f"未检测到邮箱前缀，使用账号列表，共 {len(auths)} 个账号")
            if not auths:
                raise HTTPException(status_code=401, detail="未配置 iFlow 账号")
            auth_storage = auths[0]
            actual_model = model
        else:
            email = model_parts[0]
            actual_model = model_parts[1]
            logger.debug(f"提取邮箱: {email}, 实际模型: {actual_model}")
            auth_storage = auth_svc.load_auth(email)
            
            if auth_storage is None:
                raise HTTPException(status_code=401, detail=f"账号 {email} 不存在")
        
        logger.info(f"使用账号: {auth_storage.email[:5]}...{auth_storage.email[-5:] if len(auth_storage.email) > 10 else auth_storage.email}")
        
        # 构建请求
        chat_request = IFlowChatCompletionRequest(
            model=actual_model,
            messages=[IFlowChatMessage(**msg) if isinstance(msg, dict) else msg for msg in messages],
            stream=stream,
            max_tokens=max_tokens,
            temperature=temperature,
            top_p=top_p,
            presence_penalty=presence_penalty,
            frequency_penalty=frequency_penalty,
            reasoning_effort=reasoning_effort,
        )
        
        try:
            if stream:
                # 流式响应：使用SSE流生成器（带心跳机制，与Go项目保持一致）
                stream_generator = create_sse_stream(executor, auth_storage, chat_request)
                
                # 返回标准StreamingResponse，设置完整SSE headers
                return StreamingResponse(
                    stream_generator,
                    media_type="text/event-stream",
                    headers={
                        "Cache-Control": "no-cache",
                        "Connection": "keep-alive",
                        "Access-Control-Allow-Origin": "*",
                        "X-Accel-Buffering": "no",
                        "Transfer-Encoding": "chunked",
                        # 禁用 gzip 压缩，确保流式响应格式正确
                        "Content-Encoding": "identity",
                    }
                )
            else:
                response = await executor.execute_chat_completion(auth_storage, chat_request)
                logger.info(f"非流式响应 - id: {response.id}, model: {response.model}")
                logger.debug(f"响应 choices: {response.choices}")
                logger.debug(f"响应 usage: {response.usage}")
                return response.dict()
        except Exception as e:
            logger.error(f"V1 Chat Completion 异常: {e}")
            import traceback
            logger.error(f"堆栈跟踪: {traceback.format_exc()}")
            raise HTTPException(status_code=500, detail=f"请求失败: {str(e)}")
    
    # 根路径
    @app.get("/")
    async def root():
        return {
            "name": "CLIProxyAPI",
            "version": __version__,
            "status": "running",
        }
    
    # 健康检查
    @app.get("/health")
    async def health():
        return {"status": "ok"}
    
    # 测试 SSE 格式端点
    @app.get("/test/sse")
    async def test_sse():
        """测试 SSE 格式 - 用于调试客户端解析问题（带心跳机制，与Go项目保持一致）"""
        logger.info("测试 SSE 端点被调用")
        
        # 使用标准StreamingResponse和SSE流生成器
        return StreamingResponse(
            create_test_sse_stream(),
            media_type="text/event-stream",
            headers={
                "Cache-Control": "no-cache",
                "Connection": "keep-alive",
                "Access-Control-Allow-Origin": "*",
                "X-Accel-Buffering": "no",
                "Content-Encoding": "identity",
            }
        )
    
    return app


def main():
    """启动服务器"""
    app = create_app()
    uvicorn.run(
        app,
        host=API_HOST,
        port=API_PORT,
        log_level="info",
    )


if __name__ == "__main__":
    main()
